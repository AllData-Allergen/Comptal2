{
  "name": "comptal21",
  "private": true,
  "version": "2.1.3",
  "description": "Comptal2.1 - Logiciel de comptabilité (Tauri 2 + React + SQLite)",
  "type": "module",
  "author": "Leopaul",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "db:dev": "python3 scripts/create-dev-database.py",
    "db:test-profiles": "python3 scripts/create-dev-database.py --suite --activate",
    "agent-api:start": "node --experimental-sqlite scripts/agent-api/server.mjs",
    "agent-api:mcp": "node scripts/agent-api/mcp-server.mjs",
    "agent-api:smoke": "node --experimental-sqlite scripts/agent-api/test/smoke.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:windows": "tauri build --bundles nsis",
    "tauri:build:linux": "tauri build --bundles deb,rpm",
    "tauri:ios:init": "tauri ios init",
    "tauri:ios:build": "tauri ios build",
    "agent-api:mcp-smoke": "node --experimental-sqlite scripts/agent-api/test/mcp-smoke.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "chart.js": "^4.5.1",
    "date-fns": "^2.30.0",
    "i18next": "^26.4.0",
    "lucide-react": "^1.34.0",
    "papaparse": "^5.7.0",
    "pdfmake": "^0.3.11",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.12",
    "react-router-dom": "^6.30.6",
    "react-toastify": "^11.1.0",
    "xlsx": "npm:@e965/xlsx@0.20.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.3.0",
    "@types/papaparse": "^5.5.2",
    "@types/pdfmake": "^0.2.13",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
